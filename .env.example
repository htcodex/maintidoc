# Copier en .env (jamais commité) et renseigner les valeurs localement.
POSTGRES_USER=maintidoc
POSTGRES_PASSWORD=
POSTGRES_DB=maintidoc

# Stockage S3 (SeaweedFS) — voir docker-compose.yml
S3_ACCESS_KEY=maintidoc
S3_SECRET_KEY=
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=maintidoc-assets
# Services (laisser vides pour le mode local sans Docker : Qdrant embarqué, SQLite, fichiers)
QDRANT_URL=
DATABASE_URL=

# Clé HMAC des jetons d'approbation de tickets (semaine 4) — au moins 32 octets aléatoires.
APPROVAL_HMAC_SECRET=

# Budgets du prototype
MAX_MCP_CALLS=3
MAX_MODEL_CALLS=6
MAX_PROCESSING_SECONDS=60
MAX_IMAGE_PIXELS=8000000
